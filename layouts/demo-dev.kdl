layout {
    cwd "demo/fixtures"
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="notes" focus=true {
        pane name="notes" command="./hold.sh" {
            args "notes.md"
        }
    }
    tab name="feature/geo-db" hide_floating_panes=true split_direction="vertical" {
        pane name="nvim" command="./hold.sh" {
            args "geo.rs"
        }
        pane name="cargo test" command="./hold.sh" {
            args "git-status.txt"
        }
        floating_panes {
            pane name="scratch" command="./hold.sh" {
                args "notes.md"
                x "12%"
                y "18%"
                width "48%"
                height "42%"
            }
        }
    }
    tab name="logs" {
        pane name="tail" command="tail" {
            args "-n" "20" "-f" "app.log"
        }
    }
    tab name="git" {
        pane name="git" command="./hold.sh" {
            args "git-status.txt"
        }
    }
}
